# Better Workflows isolated origin only.
# Managed by deploy/ansible/isolated-ingress.yml.
# This process does not include or control the host's global Nginx configuration.

user www-data;
worker_processes auto;
pid {{ frontend_isolated_runtime_root }}/nginx.pid;
error_log {{ frontend_isolated_log_root }}/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/javascript application/json application/ld+json application/xml image/svg+xml text/css text/plain text/xml;

    log_format betterworkflows '$remote_addr - $host [$time_local] "$request" '
                               '$status $body_bytes_sent "$http_referer" '
                               '"$http_user_agent"';
    access_log {{ frontend_isolated_log_root }}/access.log betterworkflows;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BetterWorkflowsSSL:10m;
    ssl_session_tickets off;

    server {
        listen {{ frontend_https_origin_port }} ssl default_server;
        server_name _;
        ssl_certificate {{ frontend_ssl_certificate }};
        ssl_certificate_key {{ frontend_ssl_certificate_key }};

{% for network in ['127.0.0.1', '::1'] + frontend_cloudflare_networks %}
        allow {{ network }};
{% endfor %}
        deny all;

        location / { try_files /__better_workflows_drop_https__ @drop_https; }
        location @drop_https { return 444; }
    }

    server {
        listen {{ frontend_https_origin_port }} ssl;
        server_name {{ frontend_primary_domain }};
        root {{ frontend_current_path }};
        index index.html;
        ssl_certificate {{ frontend_ssl_certificate }};
        ssl_certificate_key {{ frontend_ssl_certificate_key }};

{% for network in ['127.0.0.1', '::1'] + frontend_cloudflare_networks %}
        allow {{ network }};
{% endfor %}
        deny all;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;

        error_page 404 /404.html;

        location = /404.html {
            internal;
        }

        location = /healthz {
            add_header Cache-Control "no-store" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            try_files /healthz =404;
            access_log off;
        }

        location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            access_log off;
        }

        location ~* \.html$ {
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
        }

        location / { try_files $uri $uri/ =404; }
        location ~ /\. { deny all; access_log off; log_not_found off; }
        location ~* (?:\.env|\.git|\.htaccess|\.htpasswd|\.DS_Store)$ {
            deny all;
            access_log off;
            log_not_found off;
        }
    }

    server {
        listen {{ frontend_https_origin_port }} ssl;
        server_name {{ frontend_alias_domains | join(' ') }};
        ssl_certificate {{ frontend_ssl_certificate }};
        ssl_certificate_key {{ frontend_ssl_certificate_key }};

{% for network in ['127.0.0.1', '::1'] + frontend_cloudflare_networks %}
        allow {{ network }};
{% endfor %}
        deny all;

        location / { try_files /__better_workflows_alias_redirect__ @alias_redirect; }
        location @alias_redirect {
            return 301 https://{{ frontend_primary_domain }}$request_uri;
        }
    }

    server {
        listen {{ frontend_http_origin_port }} default_server;
        server_name _;

{% for network in ['127.0.0.1', '::1'] + frontend_cloudflare_networks %}
        allow {{ network }};
{% endfor %}
        deny all;

        location / { try_files /__better_workflows_drop_http__ @drop_http; }
        location @drop_http { return 444; }
    }

    server {
        listen {{ frontend_http_origin_port }};
        server_name {{ ([frontend_primary_domain] + frontend_alias_domains) | join(' ') }};

{% for network in ['127.0.0.1', '::1'] + frontend_cloudflare_networks %}
        allow {{ network }};
{% endfor %}
        deny all;

        location ^~ /.well-known/acme-challenge/ {
            root {{ frontend_letsencrypt_webroot }};
            default_type text/plain;
            try_files $uri =404;
        }

        location / { try_files /__better_workflows_http_redirect__ @http_redirect; }
        location @http_redirect {
            return 301 https://{{ frontend_primary_domain }}$request_uri;
        }
    }
}
