{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterworkflows.dev/schemas/task-worktree-v1.schema.json",
  "title": "Better Workflows task-worktree-v1 policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "taskBranchPrefix",
    "integrationBranchPrefix",
    "protectedBranchPatterns",
    "directCheck",
    "integration",
    "lifecycle",
    "blockedStates",
    "authorizedActions",
    "forbiddenActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "task-worktree-v1" },
    "taskBranchPrefix": { "const": "codex/" },
    "integrationBranchPrefix": { "const": "codex/integrate-" },
    "protectedBranchPatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "directCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxOutputBytes", "allowedExecutables", "isolation"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "allowedExecutables": {
          "type": "array",
          "const": ["node"]
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "nodePermissionModel", "networkGuard", "filesystemReads", "filesystemWrites"],
          "properties": {
            "id": { "const": "trusted-node-offline-v1" },
            "nodePermissionModel": { "const": true },
            "networkGuard": { "const": "deny-standard-node-network" },
            "filesystemReads": { "const": "task-worktree-and-scratch-only" },
            "filesystemWrites": { "const": "task-scoped-scratch-only" }
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["casRetries", "allowRebase", "allowForce"],
      "properties": {
        "casRetries": { "const": 1 },
        "allowRebase": { "const": false },
        "allowForce": { "const": false }
      }
    },
    "lifecycle": { "type": "array", "items": { "type": "string" } },
    "blockedStates": { "type": "array", "items": { "type": "string" } },
    "authorizedActions": { "type": "array", "items": { "type": "string" } },
    "forbiddenActions": { "type": "array", "items": { "type": "string" } }
  }
}
