{
  "name": "issues-to-root-fix-pr-merge-cleanup",
  "controlPlane": {"evidencePolicy":"typed-v1","ledgerPolicy":"ledger-v1","reviewPolicy":"code-v1","designPacketPolicy":"none","refinementPolicy":"none","deliberationPolicy":"none"},
  "executionStages": [{"id":"issue-refresh","goal":"issue-refresh","dependsOn":[],"requiredEvidence":["issue-state"],"attemptBudget":3,"kind":"regular"},{"id":"patch","goal":"patch","dependsOn":["issue-refresh"],"requiredEvidence":["change-inventory"],"attemptBudget":3,"kind":"regular"},{"id":"validate-review","goal":"validate-review","dependsOn":["patch"],"requiredEvidence":["repo-gates","patch-review"],"attemptBudget":5,"kind":"review"},{"id":"pr-merge","goal":"pr-merge","dependsOn":["validate-review"],"requiredEvidence":["pr-state","required-checks","merge-result"],"attemptBudget":1,"kind":"side-effect"},{"id":"cleanup","goal":"cleanup","dependsOn":["pr-merge"],"requiredEvidence":["cleanup-manifest"],"attemptBudget":1,"kind":"side-effect"}],
  "description": "Revalidate issues, let root implement fixes, verify, publish, merge, and clean only run-owned resources.",
