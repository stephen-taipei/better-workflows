{
  "name": "ci-release-monitor",
  "controlPlane": {"evidencePolicy":"typed-v1","ledgerPolicy":"ledger-v1","reviewPolicy":"none","designPacketPolicy":"none","refinementPolicy":"none","deliberationPolicy":"none"},
  "executionStages": [{"id":"inventory","goal":"inventory","dependsOn":[],"requiredEvidence":["workflow-inventory","repository-actions-inventory"],"attemptBudget":3,"kind":"regular"},{"id":"queue","goal":"queue","dependsOn":["inventory"],"requiredEvidence":["queue-state"],"attemptBudget":3,"kind":"regular"},{"id":"monitor-execute","goal":"monitor-execute","dependsOn":["queue"],"requiredEvidence":["run-result","required-checks"],"attemptBudget":1,"kind":"side-effect"},{"id":"provider-reconcile","goal":"provider-reconcile","dependsOn":["monitor-execute"],"requiredEvidence":["provider-reconciliation"],"attemptBudget":1,"kind":"side-effect"}],
  "actionStages": {"git.push":"monitor-execute","actions.dispatch":"provider-reconcile"},
  "deferredActions": ["deploy", "release", "branch.promote"],
  "description": "Monitor and reconcile serialized CI, deploy, release, and promotion operations. Branch promotion is performed by an actor-bound fixed Git push of a locally prepared --no-ff merge commit; workflow dispatch is performed by an actor-bound fixed GitHub CLI command and reconciled against the exact completed run.",
  "defaultMode": "critical",
  "requiredEvidence": ["workflow-inventory", "queue-state", "target-revision", "run-result", "required-checks", "provider-reconciliation", "remote-authorization"],
  "acceptance": [
    {"id": "serialized", "description": "No conflicting Web/Admin deploy was queued or running.", "critical": true},
    {"id": "revision-bound", "description": "The action targeted the verified branch and revision.", "critical": true},
    {"id": "reconciled", "description": "The final provider state is known.", "critical": true}
  ],
  "policyGates": ["one-deploy-at-a-time", "dev-staging-main", "no-fast-forward-release", "action-token"],
  "actionGates": {
    "git.push": ["workflow-inventory", "queue-state", "target-revision", "run-result", "required-checks", "remote-authorization"],
    "actions.dispatch": ["workflow-inventory", "queue-state", "target-revision", "run-result", "required-checks", "provider-reconciliation", "remote-authorization"]
  },
  "domainSkills": ["release-app"],
  "rootOnlyActions": ["workflow dispatch", "deploy", "release", "branch promotion"]
}
